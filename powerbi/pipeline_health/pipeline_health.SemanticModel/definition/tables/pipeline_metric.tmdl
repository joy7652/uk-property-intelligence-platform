table pipeline_metric
	lineageTag: 8ed0b0f1-9ed5-4ed4-b22e-7105a8be85b6

	measure 'Metric rows' = COALESCE ( COUNTROWS ( pipeline_metric ), 0 )
		formatString: 0
		lineageTag: d0a89e26-1e59-4b85-a79b-9c6a60b8995a

	measure 'Runs recorded' = COALESCE ( DISTINCTCOUNT ( pipeline_metric[run_id] ), 0 )
		formatString: 0
		lineageTag: b4a190f1-71f8-478f-91c3-4fca66665fb0

	measure 'Metric value' = SUM (pipeline_metric[value_numeric])
		lineageTag: 2caac420-f096-4de2-9027-15a5be284a79

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Share = DIVIDE ( SUM ( pipeline_metric[value_numeric] ), SUM ( pipeline_metric[denominator] ) )
		lineageTag: c580ea5b-5bf8-4450-8181-84b8d1490786

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Last recorded' =
			
			CALCULATE (
			    MAX ( pipeline_run[started_ts] ),
			    CROSSFILTER ( pipeline_run[run_id], pipeline_metric[run_id], BOTH )
			)
		formatString: General Date
		lineageTag: 7b34a277-2d7b-474a-854c-bbbbc19f44e1

	measure 'Newest data date' =
			
			CALCULATE ( MAX ( pipeline_metric[value_date] ), pipeline_metric[metric] = "newest_data_date" )
		formatString: General Date
		lineageTag: 596f2c1e-6de1-4e82-869e-964e4f59d464

	measure 'Lag days' = DATEDIFF ( [Newest data date], MAX ( pipeline_run[started_ts] ), DAY )
		formatString: 0
		lineageTag: 022e47c4-5529-4f10-bbf9-892fbf5081b2

