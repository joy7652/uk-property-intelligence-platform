		sourceColumn: execution

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition pipeline_run = m
		mode: import
		source =
				let
				    Host = "adb-7405616127577226.6.azuredatabricks.net",
				    Path = "/sql/1.0/warehouses/65e93ffd5f4ef90c",
				
				    Source   = Databricks.Catalogs(Host, Path, null),
				    Catalog  = Source{[Name = "uk_property_intel", Kind = "Database"]}[Data],
				    Schema   = Catalog{[Name = "quality", Kind = "Schema"]}[Data],
				    Runs     = Schema{[Name = "pipeline_run", Kind = "Table"]}[Data],
				    Metrics  = Schema{[Name = "pipeline_metric", Kind = "Table"]}[Data],
				
				    // Everything recorded is UTC. Dropping the offset here makes the whole query
				    // type-stable, whichever of datetime or datetimezone the connector hands back.
				    Local = Table.TransformColumns(Runs, {
				        {"started_ts",   DateTime.From, type datetime},
				        {"ended_ts",     DateTime.From, type datetime},
				        {"ingestion_ts", DateTime.From, type datetime}
				    }),
				
				    // What the row claims on its own, kept beside the derived figure so the page can
				    // show the gap rather than quietly replacing one with the other.
				    Reported = Table.AddColumn(Local, "reported_seconds",
				        each if [ended_ts] = null then null
				             else Duration.TotalSeconds([ended_ts] - [started_ts]),
				        type number),
				
				    // AuditRun defaults started_ts to ingestion_ts, so every stage one notebook
				    // opened carries the same value and the pair identifies the notebook. Stage
				    // boundaries are therefore the closes, taken in order inside the group.
				    Grouped = Table.Group(Reported, {"job_run_id", "started_ts"}, {{"stages",
				        each
				            let
				                Ordered = Table.Sort(_, {
				                    {each if [ended_ts] = null then 1 else 0, Order.Ascending},
				                    {"ended_ts", Order.Ascending}
				                }),
				                Ends   = List.Buffer(Table.Column(Ordered, "ended_ts")),
				                Seq    = Table.AddIndexColumn(Ordered, "stage_sequence", 1, 1, Int64.Type),
				                Opened = Table.AddColumn(Seq, "stage_started_ts",
				                    each if [stage_sequence] = 1 then [started_ts]
				                         else Ends{[stage_sequence] - 2},
				                    type datetime),
				                Timed  = Table.AddColumn(Opened, "stage_seconds",
				                    each if [ended_ts] = null or [stage_started_ts] = null then null
				                         else Duration.TotalSeconds([ended_ts] - [stage_started_ts]),
				                    type number)
				            in
				                Timed,
				        type table}}),
				    Stages = Table.Combine(Grouped[stages]),
				
				    // Offset from the execution's first start, for the stacked-bar Gantt.
				    RunStart = Table.Group(Stages, {"job_run_id"},
				        {{"run_started_ts", each List.Min([started_ts]), type datetime}}),
				    WithStart = Table.ExpandTableColumn(
				        Table.NestedJoin(Stages, {"job_run_id"}, RunStart, {"job_run_id"},
				            "run", JoinKind.LeftOuter),
				        "run", {"run_started_ts"}),
				    Offset = Table.AddColumn(WithStart, "offset_seconds",
				        each if [stage_started_ts] = null then null
				             else Duration.TotalSeconds([stage_started_ts] - [run_started_ts]),
				        type number),
				
				    // The plan names a stage with no layer, and six of those names are used at both
				    // bronze and silver. Bronze is left out of the key so a Silver plan cannot
				    // attach itself to the Bronze row as well.
				    Plan = Table.SelectColumns(
				        Table.SelectRows(Metrics, each [metric] = "planned_stage"),
				        {"run_id", "scope", "value_text"}),
				    PlanRuns = Table.SelectColumns(
				        Table.SelectRows(Runs, each [source] = "pipeline_plan"),
				        {"run_id", "job_run_id"}),
				    PlanKeyed = Table.AddColumn(
				        Table.ExpandTableColumn(
				            Table.NestedJoin(Plan, {"run_id"}, PlanRuns, {"run_id"}, "p", JoinKind.Inner),
				            "p", {"job_run_id"}, {"plan_job_run_id"}),
				        "plan_key", each [plan_job_run_id] & "|" & [scope], type text),
				    PlanOnly = Table.SelectColumns(PlanKeyed, {"plan_key", "value_text"}),
				
				        Keyed = Table.AddColumn(Offset, "plan_key",
				        each if [layer] = "bronze" or [job_run_id] = null then null
				             else [job_run_id] & "|" & [source],
				        type text),
				    Joinable   = Table.SelectRows(Keyed, each [plan_key] <> null),
				    Unjoinable = Table.AddColumn(
				        Table.SelectRows(Keyed, each [plan_key] = null),
				        "planned", each null, type text),
				    Matched = Table.ExpandTableColumn(
				        Table.NestedJoin(Joinable, {"plan_key"}, PlanOnly, {"plan_key"},
				            "plan", JoinKind.LeftOuter),
				        "plan", {"value_text"}, {"planned"}),
				    Planned = Table.Combine({Matched, Unjoinable}),
				
				    Labelled = Table.AddColumn(Planned, "execution",
				        each if [job_run_id] = null then "Hand run"
				             else DateTime.ToText(DateTime.From([run_started_ts]),
				                      [Format = "dd MMM HH:mm", Culture = "en-GB"]),
				        type text),
				    Tidy = Table.RemoveColumns(Labelled, {"plan_key"})
				in
				    Tidy

	changedProperty = IsHidden

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

