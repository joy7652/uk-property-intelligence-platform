	measure Skipped = COALESCE ( CALCULATE ( [Stages], pipeline_run[status] = "skipped" ), 0 )
		formatString: 0
		lineageTag: fde38bc0-f717-44e2-b229-d646475b454d

		changedProperty = IsHidden

	measure 'Wall clock (s)' =
			
			VAR FirstStart = MIN ( pipeline_run[started_ts] )
			VAR LastEnd    = MAX ( pipeline_run[ended_ts] )
			RETURN IF ( NOT ISBLANK ( LastEnd ), DATEDIFF ( FirstStart, LastEnd, SECOND ) )
		formatString: 0
		lineageTag: 05ddeb75-6328-4f18-9b46-638b07961d00

		changedProperty = IsHidden

	measure 'Blocked stages' = DISTINCTCOUNT ( skip_cause[waiting_stage] )
		formatString: 0
		lineageTag: 16c71f33-152d-4343-a4b5-89a8655f8cdd

		changedProperty = IsHidden

