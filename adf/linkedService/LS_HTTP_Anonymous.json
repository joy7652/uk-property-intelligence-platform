{
	"name": "LS_HTTP_Anonymous",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"description": "Linked Service to pull data directly from A Source Anonymously Without Headers.",
		"parameters": {
			"baseURL": {
				"type": "string",
				"defaultValue": "http://prod.publicdata.landregistry.gov.uk.s3-website-eu-west-1.amazonaws.com"
			}
		},
		"annotations": [],
		"type": "HttpServer",
		"typeProperties": {
			"url": "@{linkedService().baseURL}",
			"enableServerCertificateValidation": true,
			"authenticationType": "Anonymous"
		}
	}
}